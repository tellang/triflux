# AI 설정
.tfx/
.triflux/*
!.triflux/plans/
!.triflux/plans/**
.omc/
.omx/
.claude/**
!.claude/rules/
!.claude/rules/*.md
.codex/
.gemini/
.serena/
.playwright-mcp/
.mcp.json
# CLAUDE.md 는 공개 SSOT(tracked + npm files) — ignore 하지 않는다 (ADR-0002)

# 내부 문서 — 기본 전체 제외, 필요한 것만 허용
docs/*
!docs/assets/
!docs/design/
!docs/prd/
!docs/research/
!docs/codex-conventions.md
# 문서 파운데이션 공개 경계 (ADR-0002) — 의도적 공개 하위트리 명시
!docs/adr/
!docs/adr/**
!docs/_archive/
!docs/_archive/**
!docs/process/
!docs/process/**
!docs/recovery/
!docs/recovery/**
!docs/troubleshooting/
!docs/troubleshooting/**
!docs/req/
!docs/req/**
!docs/DECISIONS.md
!docs/README.md
docs/research/*reverse*
docs/research/*competitor*

# 리서치 (대외비 — 클론 레포, 분석 보고서, 설계문서)
/research/

# native-bridge feasibility 스모크 생성물 (휘발성 — 실행 시 재생성)
experiments/native-bridge-feasibility/*-latest-report.json

# 내부 이슈 추적
.issues/
.prompts/
/ISSUES-*.md

# 빌드/캐시
node_modules
dist/
.cache/
.codex-swarm/
.worktrees/
.test-lock/

# 기타
*.bak
*.tgz
.env
.npmrc

# ad-hoc swarm/fix scratch scripts
.tmp-*.mjs
# atomic write tmp files (nativeProxy, ensure-codex-hooks, codex-profile-config). race 때 남을 수 있다
*.tmp-[0-9]*-[0-9]*

# user-state hosts.json source-tree fallback (PR #183)
# 사용자 환경 데이터 (Tailscale IP / SSH user) 노출 방지.
# 정식 경로: ~/.config/triflux/hosts.json (POSIX) / %APPDATA%\triflux\hosts.json (Windows)
**/references/hosts.json
**/references/hosts.json.bak.*

# local Codex/Gemini state snapshots are binary backup artifacts
**/references/codex-snapshots/
**/references/gemini-snapshots/

# setup 의 MCP 정리(legacy-mcp-cleanup)가 .mcp.json 을 고치기 전에 남기는 백업
.mcp.json.tfx-bak-*

.gstack/
.superpowers/

# macOS Finder metadata
.DS_Store

# 스킬 평가 산출물(skill-creator eval)은 추적하지 않는다
skills/*-workspace/
packages/triflux/skills/*-workspace/

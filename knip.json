{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "bin/*.mjs",
        "hub/bridge.mjs",
        "scripts/preflight-cache.mjs",
        "scripts/tfx-route-worker.mjs",
        "scripts/tfx-route-post.mjs",
        "scripts/codex-profile-sanitize.mjs",
        "scripts/lib/agent-route-policy.mjs",
        "scripts/lib/cli-claude.mjs",
        "scripts/lib/codex-profile-config.mjs",
        "scripts/lib/gemini-profiles.mjs",
        "scripts/lib/mcp-filter.mjs",
        "scripts/lib/mcp-health.mjs",
        "hooks/codex-session-hook.mjs",
        "hooks/agy-session-hook.mjs",
        "hud/hud-qos-status.mjs",
        "hub/team/cli/index.mjs",
        "hub/team/cli/help.mjs",
        "hub/team/tui-viewer.mjs",
        "scripts/config-audit.mjs",
        "scripts/wt-cli.mjs"
      ],
      "project": [
        "bin/**/*.mjs",
        "scripts/**/*.{mjs,cjs}",
        "hub/**/*.mjs",
        "hooks/**/*.mjs",
        "hud/**/*.mjs"
      ]
    }
  },
  "ignoreWorkspaces": ["packages/*"],
  "ignore": ["tests/**", "skills/**", "mods/**", "**/__tests__/**"]
}

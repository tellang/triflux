    "test:unit": "node -e \"const{spawn}=require('node:child_process'),os=require('node:os');const n=Math.min(16,Math.max(4,os.availableParallelism()));const e=process.argv.slice(1);const t=e.some(a=>!a.startsWith('-'));spawn(process.execPath,['scripts/test-lock.mjs','--test','--test-force-exit','--test-concurrency='+n,...(t?e:['tests/unit/**/*.test.mjs',...e])],{stdio:'inherit'}).on('exit',(code,sig)=>process.exit(code??(sig?1:0)))\"",
    "test:integration": "node -e \"const{spawn}=require('node:child_process'),os=require('node:os');const n=Math.min(16,Math.max(4,os.availableParallelism()));const e=process.argv.slice(1);const t=e.some(a=>!a.startsWith('-'));spawn(process.execPath,['scripts/test-lock.mjs','--test','--test-force-exit','--test-concurrency='+n,...(t?e:['tests/integration/**/*.test.mjs',...e])],{stdio:'inherit'}).on('exit',(code,sig)=>process.exit(code??(sig?1:0)))\"",

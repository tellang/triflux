{
  "name": "triflux",
  "version": "10.57.1",
  "private": true,
  "description": "CLI-first multi-model orchestrator for Claude Code — route tasks to Codex, Antigravity, and Claude",
  "type": "module",
  "bin": {
    "triflux": "bin/triflux.mjs",
    "tfx": "bin/triflux.mjs",
    "tfx-live": "bin/tfx-live.mjs",
    "tfx-setup": "bin/tfx-setup.mjs",
    "tfx-doctor": "bin/tfx-doctor.mjs"
  },
  "files": [
    "adapters",
    "bin",
    "hub",
    "config",
    "skills",
    "!skills/tfx-workspace",
    "!**/failure-reports",
    "scripts",
    "hooks",
    "hud",
    ".claude-plugin",
    "docs/assets/logo-dark.svg",
    "docs/assets/logo-light.svg",
    "docs/assets/social-preview.png",
    "docs/assets/social-preview.svg",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/core",
    "packages/remote",
    "packages/triflux"
  ],
  "scripts": {
    "pack": "node scripts/pack.mjs all",
    "pack:core": "node scripts/pack.mjs core",
    "pack:remote": "node scripts/pack.mjs remote",
    "setup": "node scripts/setup.mjs",
    "prepare": "node scripts/install-commit-hook.mjs",
    "postinstall": "node scripts/setup.mjs",
    "lint": "biome check bin config hooks hub hud experiments scripts tests .claude-plugin .github package.json package-lock.json biome.json && node scripts/lint-private-info.mjs",
    "lint:fix": "biome check --write bin config hooks hub hud experiments scripts tests .claude-plugin .github package.json package-lock.json biome.json",
    "health": "npm test && npm run lint",
    "lint:skills": "node scripts/lint-skills.mjs",
    "lint:private": "node scripts/lint-private-info.mjs",
    "test": "node scripts/test-lock.mjs --test --test-force-exit --test-concurrency=8 \"tests/**/*.test.mjs\" \"scripts/__tests__/**/*.test.mjs\" && npm run lint:skills",
    "test:guard-codex-config": "node scripts/check-codex-config-stable.mjs npm test",
    "test:unit": "node scripts/test-lock.mjs --test --test-force-exit --test-concurrency=8 tests/unit/**/*.test.mjs",
    "test:integration": "node scripts/test-lock.mjs --test --test-force-exit --test-concurrency=8 tests/integration/**/*.test.mjs",
    "test:contract": "node scripts/test-lock.mjs --test --test-force-exit --test-concurrency=8 tests/contract/**/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=60 --test-coverage-functions=60 --test --test-force-exit --test-concurrency=8 \"tests/**/*.test.mjs\"",
    "release:check-sync": "node scripts/release/check-sync.mjs",
    "release:check-sync:fix": "node scripts/release/check-sync.mjs --fix",
    "release:check-mirror": "node scripts/release/check-packages-mirror.mjs",
    "release:check-mirror:fix": "node scripts/release/check-packages-mirror.mjs --fix",
    "release:bump": "node scripts/release/bump-version.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "release:verify": "node scripts/release/verify.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tellang/triflux.git"
  },
  "homepage": "https://github.com/tellang/triflux#readme",
  "author": "tellang",
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "knip": "^6.3.0"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "codex",
    "antigravity",
    "cli-routing",
    "orchestration",
    "multi-model",
    "triflux",
    "tfx"
  ]
}
